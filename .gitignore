# ── Sensitive / generated data ────────────────────────────────────────────────
holdings.json               # personal portfolio positions — never commit
portfolio_history.json      # price history (regenerated by fetch_eod.py)
portfolio_log.txt           # runtime logs
dma_cache.json              # 4-hour DMA cache — regenerated on refresh
watchlist_dma_cache.json    # watchlist DMA cache — regenerated on refresh
watchlist.json              # personal watchlist symbols — local only
goodwill.csv                # broker export — local only

# ── Scratch / infra ───────────────────────────────────────────────────────────
setup_scheduler.sh

