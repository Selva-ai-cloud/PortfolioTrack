# ── Sensitive / generated data ────────────────────────────────────────────────
# NOTE: .gitignore does NOT support inline comments — keep patterns bare.
# personal portfolio positions — never commit
holdings.json
# price history (regenerated by fetch_eod.py)
portfolio_history.json
# runtime logs
portfolio_log.txt
# 4-hour DMA cache — regenerated on refresh
dma_cache.json
# watchlist DMA cache — regenerated on refresh
watchlist_dma_cache.json
# personal watchlist symbols — local only
watchlist.json
# broker export — local only
goodwill.csv

# ── Scratch / infra ───────────────────────────────────────────────────────────
setup_scheduler.sh
# launcher-generated verification artifact
launch_verify.txt
# Flask server output (written by start_dashboard.command)
flask.log
# last-scan signal snapshot (written by signal_scan.py)
signal_state.json
# signal transition history (written by signal_scan.py)
signal_journal.json
# NIFTY 50 cache for the chart overlay
benchmark_cache.json

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
dist/
build/
.eggs/
venv/
.venv/
env/

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
