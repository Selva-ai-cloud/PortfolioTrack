<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.selva.portfolio.fundamentals</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Library/Frameworks/Python.framework/Versions/3.14/bin/python3</string>
        <string>/Users/selva/Documents/Claude/Portfolio_Tracker/fetch_fundamentals.py</string>
    </array>

    <!-- Weekly, Sunday 9:00 AM. Fundamentals only change quarterly, and the
         job makes ~220 throttled requests, so once a week is plenty. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer><key>Weekday</key><integer>0</integer></dict>
    </array>

    <!-- Logs must NOT live in ~/Documents (TCC-protected — launchd cannot
         create files there and the job dies with EX_CONFIG/78). -->
    <key>StandardOutPath</key>
    <string>/Users/selva/Library/Logs/portfolio_fundamentals.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/selva/Library/Logs/portfolio_fundamentals.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
